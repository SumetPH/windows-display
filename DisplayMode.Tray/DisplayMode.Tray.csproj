<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms reads DPI mode from here via ApplicationConfiguration.Initialize(), not from app.manifest. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DisplayMode.App</AssemblyName>
    <RootNamespace>DisplayMode.Tray</RootNamespace>
    <AssemblyTitle>DisplayMode</AssemblyTitle>
  </PropertyGroup>
</Project>
